# libbrotlicommon.pc (46e): libbrotlicommon.so.1, a system library from upstream, for builds outside
# the tree (sdk/ritteros.cmake and sdk/ritteros.meson set arch). Version:
# user/upstream/versions' (sdk_shell_test compares them).
prefix=${pcfiledir}/../..
arch=x86_64
includedir=${prefix}/build/upstream/include
libdir=${prefix}/build/system/${arch}/lib

Name: libbrotlicommon
Description: Brotli: what decoding and encoding share
Version: 1.2.1
Cflags: -I${includedir}
Libs: ${libdir}/libbrotlicommon.so.1

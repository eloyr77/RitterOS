# libssl.pc (46e): libssl.so.3, a system library from upstream, for builds outside
# the tree (sdk/ritteros.cmake and sdk/ritteros.meson set arch). Version:
# user/upstream/versions' (sdk_shell_test compares them).
prefix=${pcfiledir}/../..
arch=x86_64
includedir=${prefix}/build/upstream/include
libdir=${prefix}/build/system/${arch}/lib

Name: libssl
Description: OpenSSL's TLS
Version: 3.5.9
Requires: libcrypto
Cflags: -I${includedir}
Libs: ${libdir}/libssl.so.3

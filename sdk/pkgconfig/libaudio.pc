# libaudio.pc (43d): libaudio.so.1, for builds outside the tree
# (sdk/ritteros.cmake and sdk/ritteros.meson set arch).
prefix=${pcfiledir}/../..
arch=x86_64
includedir=${prefix}/user/include
libdir=${prefix}/build/system/${arch}/lib

Name: libaudio
Description: RitterOS's sound (WAV, /dev/pcmN)
Version: 1
Requires: ritteros
Cflags: -I${includedir}
Libs: ${libdir}/libaudio.so.1

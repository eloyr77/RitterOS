# libbrotlidec.pc (46e): libbrotlidec.so.1, a system library from upstream, for builds outside
# the tree (sdk/ritteros.cmake and sdk/ritteros.meson set arch). Version:
# user/upstream/versions' (sdk_shell_test compares them).
prefix=${pcfiledir}/../..
arch=x86_64
includedir=${prefix}/build/upstream/include
libdir=${prefix}/build/system/${arch}/lib

Name: libbrotlidec
Description: Brotli decoding
Version: 1.2.1
Requires: libbrotlicommon
Cflags: -I${includedir}
Libs: ${libdir}/libbrotlidec.so.1

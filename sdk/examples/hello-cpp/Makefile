# hello-cpp: a C++ command-line program for RitterOS (43c). Built on this
# computer with RitterOS's libc++ (the SDK's C++ rules: a .cpp in SRCS),
# then `make deploy run HOST=root@ADDRESS` as any program.
RITTEROS ?= ../../..
APP      := hello-cpp
KIND     := bin
SRCS     := hello-cpp.cpp
include $(RITTEROS)/sdk/ritteros.mk
